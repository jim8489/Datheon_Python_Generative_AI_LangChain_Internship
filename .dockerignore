# Never send credentials, local databases, vector indexes, or developer caches
# into the Docker build context.
.git/
**/.git/
**/.env
**/.env.*
!**/.env.example
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.coverage
**/htmlcov/
**/.venv/
**/venv/
**/chroma_db/
**/data/
**/*.sqlite
**/*.sqlite3
**/*.db
.DS_Store
