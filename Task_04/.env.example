# Path to the sibling Task_02 directory. Relative paths are resolved from Task_04.
TASK2_PATH=../Task_02

# Persistent chat store (relative paths are resolved from Task_04).
CHAT_DATABASE_PATH=data/conversations.sqlite3

# Conversation and retrieval behavior
MAX_HISTORY_MESSAGES=12
MAX_CONVERSATIONS=20
DEFAULT_RETRIEVAL_K=6
MAX_QUESTION_CHARS=4000
QUERY_REWRITE_ENABLED=true

# Anonymous browser identity cookie lifetime.
BROWSER_COOKIE_TTL_DAYS=365

# Optional: provide a stable secret (at least 32 characters) for signing browser IDs.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If omitted, Task 4 creates Task_04/data/.browser_signing_key and keeps it out of Git.
# SESSION_SIGNING_KEY=

# Optional logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
